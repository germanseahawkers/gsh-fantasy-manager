APP_ENV=production
APP_URL=https://fantasy.germanseahawkers.com
APP_TIMEZONE=Europe/Berlin
APP_KEY=replace-with-a-long-random-string

# Plesk/MySQL example:
DB_DSN=mysql:host=localhost;dbname=gsh_fantasy;charset=utf8mb4
DB_USER=gsh_fantasy
DB_PASSWORD=replace-me

# Generate with: php bin/password.php 'your password'
ADMIN_PASSWORD_HASH=replace-with-password-hash

MAIL_TRANSPORT=smtp
MAIL_FROM=admin@germanseahawkers.com
MAIL_FROM_NAME=German Sea Hawkers Fantasy Football
SMTP_HOST=smtp-relay.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_TIMEOUT=15

# Für Google SMTP Relay mit freigeschalteter Server-IP leer lassen:
SMTP_USERNAME=
SMTP_PASSWORD=
